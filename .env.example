# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit .env (it is in .gitignore).

# Local Docker:  bolt://localhost:7687
# Neo4j Aura:    neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Use at least 8 characters. docker-compose.yml also reads this value to set the database password.
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# Folder with the SENTINEL tables from the instructor's supabase_db_kit
# (the folder that contains transactions/, labels/, customers/, devices/, merchants/)
DATA_DIR=supabase_db_kit/data/tables

# Minimum number of transactions to load (the task needs at least 5000). Customers who share a device are
# always included, so the real load is larger (43,993). Use 0 to load all 110,000.
TARGET_TXNS=5000
